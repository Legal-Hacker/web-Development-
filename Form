<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Form - Lets learn it</title>
</head>
<body>
  <h1>form apply for Course</h1>
  <form action="post">
    <div>
    <label for="Username">Enter Your Username</label>
    <input type="text" name="Username" id="Username" placeholder="Enter Your">
    </div>
    <div>
    <input type="radio" name="Gender" id="Male" value="Male"><!--Radio button me 2 option me ek select hota hai-->
    <label for="Male">Male</label>
    <input type="radio" name="Gender" id="Female" value="Female"><!--cheakbox me multiple selction hota hai-->
    <label for="Female">Female</label>
    </div>
    <div>
      <input type="checkbox" name="Agree" id="Agree">
      <label for="Agree">Agree</label>
    </div>
    <div>
      <label for="Comment">Comment here</label>
      <textarea id="Comment" rows="4" cols="50">Comment here</textarea>
    </div>
    <div>
      <select name="Fruits" id="">
        <option value="Apple">Apple</option>
        <option value="Banana">Banana</option>
      </select>
    </div>
    <div>
      <label for="Submit">Submit</label>
      <button>Submit</button>
    </div>
  </form>
</body>
</html>
